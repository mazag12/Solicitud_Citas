{
  "name": "solicitud-citas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:ssr:Solicitud_Citas": "node --env-file-if-exists=.env dist/Solicitud_Citas/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "21.0.0",
    "@angular/compiler": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/forms": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/platform-server": "21.0.0",
    "@angular/router": "21.0.0",
    "@angular/ssr": "21.0.4",
    "@emailjs/browser": "^5.0.3",
    "express": "5.1.0",
    "nodemailer": "10.1.7",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "@angular/platform-browser-dynamic": "21.0.0",
    "@netlify/angular-runtime": "^4.0.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/express": "5.0.1",
    "@types/node": "20.17.19",
    "jsdom": "27.1.0",
    "postcss": "8.5.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "4.0.8"
  }
}
